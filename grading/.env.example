# Archipelago Grading - Example Configuration
# Copy this file to .env and fill in values as needed

# Environment type: local, dev, prod
ENV=local

# =============================================================================
# LLM Provider API Keys (at least one required for LLM-based verifiers)
# =============================================================================
# Anthropic (recommended for grading)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# OR use LiteLLM Proxy for all LLM requests
LITELLM_PROXY_API_BASE=
LITELLM_PROXY_API_KEY=

# Prompt-prefix caching for the criterion fan-out: "5m", "1h", or empty (off).
# A criterion rubric sends one LLM call per criterion, each re-sending the same
# deliverable; this marks that shared prefix cacheable so it bills at the
# cache_read tier after the first call. Anthropic judges only.
GRADING_PROMPT_CACHE_TTL=

# Fan-out size at which a dependency level runs its FIRST verifier alone before
# the rest, so that one writes the shared prefix and the others read it.
# Without this the first LLM_CONCURRENCY_LIMIT (10) calls all leave before any
# entry exists, so each pays the 1.25x write premium and none gets the 0.1x
# read -- measured ~1:1 writes:reads on dev instead of 1:N-1.
#
# The cost is one extra wave of latency, fixed, against a saving proportional
# to the fan-out: ~+50% wall clock at 12 calls but only ~+8% at 118. Hence a
# threshold. 0 disables (default); requires GRADING_PROMPT_CACHE_TTL to be set.
#
# 40 is the suggested starting point. Prod read:write on opus-5 sits at 5-6:1
# (19.5:1 on the one day calls were slow enough to arrive staggered), and under
# the race model a fan-out of N yields ~10 writes and N-10 reads, which puts the
# typical level near 65 verifiers. A threshold of 100 would therefore sit above
# most levels and capture very little. This is inferred from a ratio, not
# measured: the `studio.grading.prefix_cache_primed` fan-out histogram this PR
# emits is what should actually set it, once there is a week of it.
#
# Left commented out on purpose, unlike every other placeholder above: this is
# the only int in this file. Settings does not set env_ignore_empty, so a bare
# `NAME=` is read as the string "" and fails int parsing — which would make
# `cp .env.example .env` (what the README says to do) raise a ValidationError
# on every import instead of falling back to the disabled default. Uncomment
# with a real value to enable.
# GRADING_PROMPT_CACHE_PRIME_MIN_FANOUT=40

# =============================================================================
# Document Extraction (optional but recommended for PDFs, Office docs)
# =============================================================================
# Preferred: route through Mercor's document cache so identical files across
# snapshots/trajectories only get parsed once. Both vars must be set;
# otherwise the grading service falls back to its direct parser.
#   MERCOR_DOCUMENT_API     — full URL of the parse endpoint (per-env constant)
#                             e.g. https://api.studio.mercor.com/internal/archipelago/document-cache/parse
#   MERCOR_DOCUMENT_API_KEY — internal API key (same value as INTERNAL_API_KEY)
MERCOR_DOCUMENT_API=
MERCOR_DOCUMENT_API_KEY=

# Direct Reducto API key. Used as a fallback when MERCOR_DOCUMENT_API /
# MERCOR_DOCUMENT_API_KEY are not set (typical for local dev). Ignored when
# the Mercor document cache is enabled.
REDUCTO_API_KEY=

# Firecrawl for web content extraction
ACE_FIRECRAWL_API_KEY=

# =============================================================================
# Webhook for saving results (optional)
# =============================================================================
SAVE_WEBHOOK_URL=
SAVE_WEBHOOK_API_KEY=
SCORE_WEBHOOK_URL=

# =============================================================================
# Datadog logging (optional)
# =============================================================================
DATADOG_LOGGING=false
DATADOG_API_KEY=
DATADOG_APP_KEY=
